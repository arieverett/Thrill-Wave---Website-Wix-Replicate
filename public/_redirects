# Cloudflare Pages redirects. Keeps old Wix URLs working (and keeps their Google ranking).
# Format: <from> <to> <status>

# Wix pages that were empty or placeholders
/paywall                    /                 301
/faq                        /contact          301
/inquiry-services-page      /contact          301
/pricing-plans/*            /medical#packages 301

# Wix blog plumbing
/blog/page/*                /blog             301
/profile/*                  /blog             301
/blog/categories/tech       /blog             301
/blog/categories/sports     /blog             301
/blog/categories/art        /blog             301
/blog/categories/news       /blog             301
/blog/categories/law        /blog             301

# Common guesses
/home                       /                 301
/about                      /#team            301
/work                       /portfolio        301
/process                    /app-landing-page 301
